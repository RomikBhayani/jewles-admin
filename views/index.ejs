<div class="card">
    <h2>Welcome to JewelAdmin</h2>
    <p>Use the sidebar to manage products, rates, and theme settings.</p>
</div>

<div class="dashboard-stats" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem;">
    <div class="card">
        <h3>Total Products</h3>
        <p style="font-size: 2rem; font-weight: bold;"><%= productCount %></p>
    </div>
    <div class="card">
        <h3>Active Metals</h3>
        <p style="font-size: 2rem; font-weight: bold;"><%= metalCount %></p>
    </div>
    <div class="card">
        <h3>Active Diamonds</h3>
        <p style="font-size: 2rem; font-weight: bold;"><%= diamondCount %></p>
    </div>
</div>
