<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> | Store Preview</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; margin: 0; padding: 2rem; background: #fff; color: #1a1a1a; }
        .product-preview { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
        .product-image { background: #f9f9f9; aspect-ratio: 1; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 5rem; color: #ddd; }
        h1 { font-family: 'Playfair Display', serif; font-size: 2.5rem; margin-bottom: 0.5rem; }
        .sku { color: #888; text-transform: uppercase; letter-spacing: 1px; font-size: 0.8rem; margin-bottom: 2rem; display: block; }
        .price { font-size: 2rem; font-weight: 600; color: #111; margin-bottom: 2rem; }
        .description { line-height: 1.6; color: #555; margin-bottom: 2.5rem; }
        .selector-group { margin-bottom: 1.5rem; }
        .selector-group label { display: block; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.75rem; color: #111; }
        .options { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .option { border: 1px solid #ddd; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; font-size: 0.9rem; transition: all 0.2s; }
        .option.active { border-color: #111; background: #111; color: #fff; }
        .buy-button { width: 100%; background: #111; color: #fff; border: none; padding: 1.25rem; font-weight: 600; font-size: 1rem; border-radius: 4px; margin-top: 2rem; cursor: pointer; }
    </style>
</head>
<body>
    <div class="product-preview">
        <div class="product-image">
            <i class="fas fa-gem"></i>
        </div>
        <div class="product-info">
            <h1><%= product.name %></h1>
            <span class="sku">SKU: <%= product.sku %></span>
            <div class="price" id="display-price">Select options...</div>
            <p class="description"><%= product.description %></p>

            <div class="selector-group">
                <label>Metal</label>
                <div class="options" id="metal-options">
                    <% product.availableMetals.forEach(metal => { %>
                        <div class="option" data-value="<%= metal %>"><%= metal %></div>
                    <% }) %>
                </div>
            </div>

            <div class="selector-group">
                <label>Karat</label>
                <div class="options" id="karat-options">
                    <% product.availableKarats.forEach(karat => { %>
                        <div class="option" data-value="<%= karat %>"><%= karat %></div>
                    <% }) %>
                </div>
            </div>

            <div class="selector-group">
                <label>Diamond Type</label>
                <div class="options" id="diamond-options">
                    <% product.availableDiamonds.forEach(diamond => { %>
                        <div class="option" data-value="<%= diamond %>"><%= diamond %></div>
                    <% }) %>
                </div>
            </div>

            <button class="buy-button">ADD TO BAG</button>
        </div>
    </div>

    <script>
        const variants = <%- JSON.stringify(variants) %>;
        const metalRates = <%- JSON.stringify(metalRates) %>;
        const diamondRates = <%- JSON.stringify(diamondRates) %>;
        const karats = <%- JSON.stringify(karats) %>;
        const product = <%- JSON.stringify(product) %>;

        const selection = {
            metal: '<%= product.availableMetals[0] %>',
            karat: '<%= product.availableKarats[0] %>',
            diamondType: '<%= product.availableDiamonds[0] %>'
        };

        function updatePrice() {
            const metalRate = metalRates.find(r => r.metalType === selection.metal)?.ratePerGram || 0;
            const diamondRate = diamondRates.find(r => r.diamondType === selection.diamondType)?.ratePerPiece || 0;
            const purity = karats.find(k => k.name === selection.karat)?.purity || 0;

            const metalCost = metalRate * product.baseWeight * purity;
            const diamondCost = diamondRate * product.diamondCount;
            const basePrice = metalCost + diamondCost;
            const finalPrice = basePrice + (basePrice * (product.makingChargesPercent / 100));

            document.getElementById('display-price').textContent = '$' + finalPrice.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }

        function initSelectors() {
            ['metal', 'karat', 'diamondType'].forEach(type => {
                const container = document.getElementById(`${type === 'diamondType' ? 'diamond' : type}-options`);
                const options = container.querySelectorAll('.option');

                options.forEach(opt => {
                    if (opt.dataset.value === selection[type]) opt.classList.add('active');

                    opt.addEventListener('click', () => {
                        options.forEach(o => o.classList.remove('active'));
                        opt.classList.add('active');
                        selection[type] = opt.dataset.value;
                        updatePrice();
                    });
                });
            });
        }

        initSelectors();
        updatePrice();
    </script>
</body>
</html>
