<div class="actions" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
    <a href="/admin/products/create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Product
    </a>

    <form action="/admin/products" method="GET" style="display: flex; gap: 0.5rem; background: #fff; padding: 0.5rem; border-radius: var(--border-radius); box-shadow: var(--shadow);">
        <div style="position: relative;">
            <i class="fas fa-search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
            <input type="text" name="search" placeholder="Search products..." value="<%= search %>" class="form-control" style="width: 300px; padding-left: 2.5rem; border: none;">
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th><a href="?sortBy=sku&order=<%= sortBy === 'sku' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= search %>">SKU <i class="fas fa-sort"></i></a></th>
                <th><a href="?sortBy=name&order=<%= sortBy === 'name' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= search %>">Name <i class="fas fa-sort"></i></a></th>
                <th><a href="?sortBy=category&order=<%= sortBy === 'category' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= search %>">Category <i class="fas fa-sort"></i></a></th>
                <th><a href="?sortBy=baseWeight&order=<%= sortBy === 'baseWeight' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= search %>">Weight <i class="fas fa-sort"></i></a></th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
                <tr>
                    <td><%= product.sku %></td>
                    <td><%= product.name %></td>
                    <td><%= product.category %></td>
                    <td><%= product.baseWeight %></td>
                    <td>
                        <div style="display: flex; gap: 0.5rem;">
                            <a href="/admin/products/<%= product._id %>" class="btn btn-sm btn-secondary" title="View Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <form action="/admin/products/<%= product._id %>?_method=DELETE" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" title="Delete Product">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% }) %>
            <% if (products.length === 0) { %>
                <tr>
                    <td colspan="5" style="text-align: center;">No products found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <% if (pages > 1) { %>
        <div class="pagination" style="margin-top: 1.5rem; display: flex; gap: 0.5rem; justify-content: center;">
            <% for(let i = 1; i <= pages; i++) { %>
                <a href="/admin/products?page=<%= i %>&search=<%= search %>&sortBy=<%= sortBy %>&order=<%= order %>" class="btn <%= currentPage === i ? 'btn-primary' : 'btn-secondary' %> btn-sm">
                    <%= i %>
                </a>
            <% } %>
        </div>
    <% } %>
</div>

<style>
    .btn-secondary {
        background-color: var(--secondary-color);
        color: #fff;
    }
    thead th a {
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>
