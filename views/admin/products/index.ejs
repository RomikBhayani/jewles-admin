<div class="actions" style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
    <a href="/admin/products/create" class="btn btn-primary">Add New Product</a>

    <form action="/admin/products" method="GET" style="display: flex; gap: 0.5rem;">
        <input type="text" name="search" placeholder="Search by name or SKU..." value="<%= search %>" class="form-control" style="width: 250px;">
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>SKU</th>
                <th>Name</th>
                <th>Category</th>
                <th>Weight (g)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
                <tr>
                    <td><%= product.sku %></td>
                    <td><%= product.name %></td>
                    <td><%= product.category %></td>
                    <td><%= product.baseWeight %></td>
                    <td>
                        <a href="/admin/products/<%= product._id %>" class="btn btn-sm btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">View</a>
                        <form action="/admin/products/<%= product._id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" onclick="return confirm('Are you sure?')">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
            <% if (products.length === 0) { %>
                <tr>
                    <td colspan="5" style="text-align: center;">No products found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <% if (pages > 1) { %>
        <div class="pagination" style="margin-top: 1.5rem; display: flex; gap: 0.5rem; justify-content: center;">
            <% for(let i = 1; i <= pages; i++) { %>
                <a href="/admin/products?page=<%= i %>&search=<%= search %>" class="btn <%= currentPage === i ? 'btn-primary' : 'btn-secondary' %> btn-sm">
                    <%= i %>
                </a>
            <% } %>
        </div>
    <% } %>
</div>

<style>
    .btn-secondary {
        background-color: var(--secondary-color);
        color: #fff;
    }
</style>
