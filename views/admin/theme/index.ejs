<div class="card">
    <form action="/admin/theme" method="POST">
        <div class="form-group">
            <label>Dark Mode</label>
            <input type="checkbox" name="darkMode" <%= themeConfig.darkMode ? 'checked' : '' %>>
        </div>
        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
            <div class="form-group">
                <label>Primary Color</label>
                <input type="color" name="primaryColor" value="<%= themeConfig.primaryColor %>">
            </div>
            <div class="form-group">
                <label>Secondary Color</label>
                <input type="color" name="secondaryColor" value="<%= themeConfig.secondaryColor %>">
            </div>
            <div class="form-group">
                <label>Accent Color</label>
                <input type="color" name="accentColor" value="<%= themeConfig.accentColor %>">
            </div>
            <div class="form-group">
                <label>Danger Color</label>
                <input type="color" name="dangerColor" value="<%= themeConfig.dangerColor %>">
            </div>
            <div class="form-group">
                <label>Background Color</label>
                <input type="color" name="backgroundColor" value="<%= themeConfig.backgroundColor %>">
            </div>
            <div class="form-group">
                <label>Text Color</label>
                <input type="color" name="textColor" value="<%= themeConfig.textColor %>">
            </div>
            <div class="form-group">
                <label>Sidebar Color</label>
                <input type="color" name="sidebarColor" value="<%= themeConfig.sidebarColor %>">
            </div>
            <div class="form-group">
                <label>Sidebar Text Color</label>
                <input type="color" name="sidebarTextColor" value="<%= themeConfig.sidebarTextColor %>">
            </div>
            <div class="form-group">
                <label>Border Radius (e.g. 0.375rem)</label>
                <input type="text" name="borderRadius" value="<%= themeConfig.borderRadius %>">
            </div>
            <div class="form-group">
                <label>Font Size (e.g. 1rem)</label>
                <input type="text" name="fontSize" value="<%= themeConfig.fontSize %>">
            </div>
            <div class="form-group">
                <label>Spacing (e.g. 1rem)</label>
                <input type="text" name="spacing" value="<%= themeConfig.spacing %>">
            </div>
        </div>
        <div style="margin-top: 1rem;">
            <button type="submit" class="btn btn-primary">Save Theme Settings</button>
        </div>
    </form>
</div>

<style>
    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
    }
    .form-group input[type="text"], .form-group input[type="color"] {
        width: 100%;
        padding: 0.5rem;
        border-radius: var(--border-radius);
        border: 1px solid #ccc;
    }
</style>
